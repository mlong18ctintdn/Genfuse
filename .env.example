# ---------- Site ----------
# Production: your live domain, no trailing slash (e.g. https://genfuse.vercel.app)
# Local dev:  http://localhost:3000
# NEXT_PUBLIC_* values are inlined at BUILD time on Vercel: redeploy after changing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (Project Settings -> API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "anon" key (may be labelled "publishable" key in newer dashboards)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI ----------
# Google AI Studio -> Get API key. This exact name is read by @ai-sdk/google.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional fallback / alternative provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# google | openai  (which one to try first; falls back to whichever key exists)
AI_PRIMARY_PROVIDER=google

# ---------- PayOS (my.payos.vn -> payment channel -> API keys) ----------
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
